# Local PostgreSQL connection used by spark/load_postgres.py.
# Keep real credentials in .env; do not commit that file.
DATABASE_URL=postgresql+psycopg://stock_user:change_me@localhost:5432/stock_market

# dbt PostgreSQL profile settings.
DBT_HOST=localhost
DBT_PORT=5432
DBT_USER=stock_user
DBT_ENV_SECRET_PASSWORD=change_me
DBT_DATABASE=stock_market
DBT_SCHEMA=public
DBT_SOURCE_SCHEMA=public
